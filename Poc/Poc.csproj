<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Poc</AssemblyName>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sibling checkout of the exact source shipped as WabiSabi 1.3.0. setup.sh
         pins it to commit 6ef358a and drops an InternalsVisibleTo("Poc") shim so
         the PoC can construct request records via their internal constructors. -->
    <ProjectReference Include="../NWabiSabi/csharp/WabiSabi/WabiSabi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Place the native binary next to Poc.dll for P/Invoke at runtime. -->
    <None Include="../NWabiSabi/csharp/WabiSabi/runtimes/linux-x64/native/libwabisabi.so"
          Condition="Exists('../NWabiSabi/csharp/WabiSabi/runtimes/linux-x64/native/libwabisabi.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libwabisabi.so</Link>
    </None>
  </ItemGroup>
</Project>
